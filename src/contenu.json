          {
            "titre": "Créer votre dossier sur Sportyneo",
            "paragraphes": [
              "L’inscription sur Sportyneo est obligatoire pour les adultes, même si vous choisissez de régler votre cotisation au club."
            ],
            "liens": [
              {
                "libelle": "M’inscrire sur Sportyneo",
                "reference": "inscription"
              }
